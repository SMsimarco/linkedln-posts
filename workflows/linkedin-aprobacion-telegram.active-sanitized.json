        "jsCode": "const payload = $input.first().json;\nconst query = payload.query || {};\nconst expectedToken = $env.LINKEDIN_EDITORIAL_APPROVAL_TOKEN;\n\nif (!expectedToken) {\n  throw new Error('Falta configurar LINKEDIN_EDITORIAL_APPROVAL_TOKEN');\n}\nif (!query.token || query.token !== expectedToken) {\n  throw new Error('Solicitud no autorizada');\n}\nif (typeof query.pieza_id !== 'string' || !query.pieza_id.trim()) {\n  throw new Error('pieza_id requerido');\n}\n\nreturn [{\n  json: {\n    pieza_id: query.pieza_id.trim(),\n    estado_actual: 'PENDIENTE_REVISION',\n    estado_nuevo: 'APROBADO',\n    resultado: 'APROBADO'\n  }\n}];"
      },
